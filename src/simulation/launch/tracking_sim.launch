<launch>
  <!-- Map generator -->
  <node pkg="mockamap" type="mockamap_node" name="mockamap_node" output="screen">
    <rosparam file="$(find uav_simulator)/config/mockamap.yaml"/>
    <remap from="/mock_map" to="/global_map"/>
  </node>

  <!-- Target simulation -->
  <group ns="target">
    <node pkg="nodelet" type="nodelet" name="manager" args="manager" output="screen">
      <param name="num_worker_threads" value="16"/>
    </node>
    <node pkg="nodelet" type="nodelet" name="so3_quadrotor" args="load so3_quadrotor/Nodelet manager" output="screen"><!-- 目标无人机的动力学仿真节点，接收SO3指令，发布里程计、imu、可视化消息 -->
      <rosparam file="$(find uav_simulator)/config/so3_quadrotor.yaml"/>
      <param name="init_x" value="5" />
      <param name="init_y" value="0" />
      <param name="init_z" value="2" />
      <remap from="~odom" to="odom"/>
      <remap from="~imu" to="imu"/>
      <remap from="~so3cmd" to="so3cmd"/>
      <remap from="~vis" to="vis"/>
    </node>
    <node pkg="nodelet" type="nodelet" name="so3_controller" args="load so3_controller/Nodelet manager" output="screen"><!-- 目标无人机的控制器节点，接收位置控制指令、里程计、imu，发布SO3指令给动力学仿真节点 -->
      <rosparam file="$(find uav_simulator)/config/so3_controller.yaml"/>
      <remap from="~odom" to="odom"/>
      <remap from="~imu" to="imu" />
      <remap from="~so3cmd" to="so3cmd"/>
      <remap from="~position_cmd" to="position_cmd"/>
    </node>
    <!-- 目标建图节点，直接获知全局地图 -->
    <node pkg="nodelet" type="nodelet" name="mapping" args="load mapping/Nodelet manager" output="screen">
      <rosparam file="$(find uav_simulator)/config/mockamap.yaml"/>
      <remap from="~global_map" to="/global_map"/>
      <remap from="~gridmap" to="gridmap"/>
      <remap from="~gridmap_inflate" to="gridmap_inflate"/>
      <param name="resolution" value="0.15"/>
      <param name="inflate_size" value="2"/>
      <param name="use_global_map" value="true"/>
    </node>
    <node pkg="odom_visualization" name="odom_visualization" type="odom_visualization" output="screen">
      <remap from="~odom" to="odom" />
      <param name="robot_scale" value="0.7"/>
    </node>

    <node pkg="nodelet" type="nodelet" name="planning" args="load planning/Nodelet manager" output="screen">
      <remap from="~odom" to="odom"/>
      <remap from="~gridmap_inflate" to="gridmap_inflate"/>
      <remap from="~heartbeat" to="heartbeat"/>
      <remap from="~trajectory" to="trajectory"/>
      <remap from="~replanState" to="replanState"/>
      <remap from="~triger" to="/move_base_simple/goal"/><!-- target的目标位置直接由rviz 2D Nav Goal指定 -->

      <param name="plan_hz" value="20"/>

      <param name="K" value="8"/> <!-- 计算代价时，每段轨迹内的采样点数 -->
      <param name="vmax" value="1.5"/>
      <param name="amax" value="2.5"/>
      <param name="rhoT" value="100.0"/><!-- 轨迹总时间成本的权重 -->
      <param name="rhoP" value="10000.0"/><!-- 避障成本的权重 -->
      <param name="rhoV" value="1000.0"/><!-- 速度约束成本的权重 -->
      <param name="rhoA" value="1000.0"/><!-- 加速度约束成本的权重 -->
      <param name="clearance_d" value="0.2"/><!-- 距离障碍的安全间隙 -->
      <param name="tolerance_d" value="0.5"/><!--与目标距离的容忍度，可以在这个幅度内有微小偏差 -->
      <param name="tracking_dist" value="3.0"/>
      <param name="debug" value="false"/>
      <param name="fake" value="true"/>

    </node>
    <node pkg="planning" name="traj_server" type="traj_server" output="screen"><!-- 轨迹发布节点，将规划的轨迹转化为位置控制指令发送给target/position_cmd话题 -->
      <remap from="~position_cmd" to="position_cmd"/>
      <remap from="~trajectory" to="trajectory"/>
      <remap from="~heartbeat" to="heartbeat"/>
      <param name="time_forward" value="1.0" type="double"/>
    </node>
  </group>

  <!-- Swarm planning for drone 0 -->
  <group ns="drone0">
    <include file="$(find ego_planner)/launch/run_in_sim.launch">
      <arg name="drone_id" value="0"/>
      <arg name="map_size_x" value="20"/>
      <arg name="map_size_y" value="20"/>
      <arg name="map_size_z" value="5"/>
      <arg name="target_x" value="5"/>
      <arg name="target_y" value="0"/>
      <arg name="target_z" value="2"/>
      <arg name="init_x" value="0"/>
      <arg name="init_y" value="0"/>
      <arg name="init_z" value="2"/>
      <arg name="odom_topic" value="visual_slam/odom"/>
      <arg name="formation_type" value="1"/> <!-- 1 for hexagon formation -->
    </include>
    <!-- Target estimation for drone 0 -->
    <node name="target_estimator" pkg="target_ekf" type="target_ekf_sim_node" output="screen">
      <remap from="~target_odom" to="/target/odom"/>
      <remap from="~yolo" to="/target/odom"/>
      <remap from="~odom" to="visual_slam/odom"/>
    </node>
  </group>

  <!-- Swarm planning for drone 1 -->
  <group ns="drone1">
    <include file="$(find ego_planner)/launch/run_in_sim.launch">
      <arg name="drone_id" value="1"/>
      <arg name="map_size_x" value="20"/>
      <arg name="map_size_y" value="20"/>
      <arg name="map_size_z" value="5"/>
      <arg name="target_x" value="5"/>
      <arg name="target_y" value="0"/>
      <arg name="target_z" value="2"/>
      <arg name="init_x" value="2"/>
      <arg name="init_y" value="0"/>
      <arg name="init_z" value="2"/>
      <arg name="odom_topic" value="visual_slam/odom"/>
      <arg name="formation_type" value="1"/>
    </include>
    <!-- Target estimation for drone 1 -->
    <node name="target_estimator" pkg="target_ekf" type="target_ekf_sim_node" output="screen">
      <remap from="~target_odom" to="/target/odom"/>
      <remap from="~yolo" to="/target/odom"/>
      <remap from="~odom" to="visual_slam/odom"/>
    </node>
  </group>

  <!-- Swarm planning for drone 2 -->
  <group ns="drone2">
    <include file="$(find ego_planner)/launch/run_in_sim.launch">
      <arg name="drone_id" value="2"/>
      <arg name="map_size_x" value="20"/>
      <arg name="map_size_y" value="20"/>
      <arg name="map_size_z" value="5"/>
      <arg name="target_x" value="5"/>
      <arg name="target_y" value="0"/>
      <arg name="target_z" value="2"/>
      <arg name="init_x" value="-2"/>
      <arg name="init_y" value="0"/>
      <arg name="init_z" value="2"/>
      <arg name="odom_topic" value="visual_slam/odom"/>
      <arg name="formation_type" value="1"/>
    </include>
    <!-- Target estimation for drone 2 -->
    <node name="target_estimator" pkg="target_ekf" type="target_ekf_sim_node" output="screen">
      <remap from="~target_odom" to="/target/odom"/>
      <remap from="~yolo" to="/target/odom"/>
      <remap from="~odom" to="visual_slam/odom"/>
    </node>
  </group>

  <!-- Add more drones as needed -->

</launch>