Panels:
  - Class: rviz/Displays
    Help Height: 0
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /target1
        - /drone01
      Splitter Ratio: 0.46234309673309326
    Tree Height: 900
  - Class: rviz/Selection
    Name: Selection
  - Class: rviz/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
  - Class: rviz/Time
    Experimental: false
    Name: Time
    SyncMode: 0
    SyncSource: world_map
Preferences:
  PromptSaveOnExit: true
Toolbars:
  toolButtonStyle: 2
Visualization Manager:
  Class: ""
  Displays:

    # ── 全局地图 ──────────────────────────────────────────────────────
    - Alpha: 0.15
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 5
        Min Value: 0
        Value: true
      Axis: Z
      Channel Name: intensity
      Class: rviz/PointCloud2
      Color: 0; 0; 0
      Color Transformer: FlatColor
      Decay Time: 0
      Enabled: true
      Invert Rainbow: false
      Max Color: 255; 255; 255
      Min Color: 0; 0; 0
      Name: world_map
      Position Transformer: XYZ
      Queue Size: 1
      Selectable: true
      Size (Pixels): 3
      Size (m): 0.20000000298023224
      Style: Boxes
      Topic: /global_map
      Unreliable: false
      Use Fixed Frame: true
      Use rainbow: true
      Value: true

    # ── EKF 目标估计（所有跟踪无人机共享同一话题） ────────────────────
    - Angle Tolerance: 0.009999999776482582
      Class: rviz/Odometry
      Covariance:
        Orientation:
          Alpha: 0.5
          Color: 255; 255; 127
          Color Style: Unique
          Frame: Local
          Offset: 1
          Scale: 1
          Value: false
        Position:
          Alpha: 0.30000001192092896
          Color: 204; 51; 204
          Scale: 1
          Value: false
        Value: false
      Enabled: true
      Keep: 1
      Name: target_ekf_odom
      Position Tolerance: 0.009999999776482582
      Queue Size: 10
      Shape:
        Alpha: 1
        Axes Length: 1
        Axes Radius: 0.10000000149011612
        Color: 255; 25; 0
        Head Length: 0.30000001192092896
        Head Radius: 0.10000000149011612
        Shaft Length: 1
        Shaft Radius: 0.05000000074505806
        Value: Axes
      Topic: /target_ekf_odom
      Unreliable: false
      Value: true

    # ── 目标无人机 ────────────────────────────────────────────────────
    - Class: rviz/Group
      Enabled: true
      Name: target
      Displays:
        - Class: rviz/Group
          Enabled: true
          Name: odom_vis
          Displays:
            - Class: rviz/Marker
              Enabled: true
              Marker Topic: /target/odom_visualization/robot
              Name: drone
              Namespaces:
                mesh: true
              Queue Size: 100
              Value: true
            - Alpha: 1
              Buffer Length: 1
              Class: rviz/Path
              Color: 255; 50; 50
              Enabled: false
              Line Style: Billboards
              Line Width: 0.029999999329447746
              Name: path
              Queue Size: 10
              Topic: /target/odom_visualization/path
              Unreliable: false
              Value: false
        - Class: rviz/Group
          Enabled: true
          Name: planning
          Displays:
            - Alpha: 1
              Buffer Length: 1
              Class: rviz/Path
              Color: 255; 50; 50
              Enabled: true
              Line Style: Billboards
              Line Width: 0.06
              Name: traj
              Queue Size: 10
              Topic: /target/planning/traj
              Unreliable: false
              Value: true
            - Alpha: 1
              Buffer Length: 1
              Class: rviz/Path
              Color: 255; 200; 0
              Enabled: false
              Line Style: Billboards
              Line Width: 0.04
              Name: astar
              Queue Size: 10
              Topic: /target/planning/astar
              Unreliable: false
              Value: false

    # ── drone0（完整调试显示） ─────────────────────────────────────────
    - Class: rviz/Group
      Enabled: true
      Name: drone0
      Displays:
        - Class: rviz/Group
          Enabled: true
          Name: odom_vis
          Displays:
            - Class: rviz/Marker
              Enabled: true
              Marker Topic: /drone0/odom_visualization/robot
              Name: drone
              Namespaces:
                mesh: true
              Queue Size: 100
              Value: true
            - Class: rviz/MarkerArray
              Enabled: true
              Marker Topic: /drone0/odom_visualization/fov_visual
              Name: fov
              Namespaces:
                fov_edges: true
                fov_nodes: true
              Queue Size: 100
              Value: true
        - Class: rviz/Group
          Enabled: true
          Name: mapping
          Displays:
            - Alpha: 1
              Autocompute Intensity Bounds: true
              Autocompute Value Bounds:
                Max Value: 5
                Min Value: -5
                Value: true
              Axis: Z
              Channel Name: intensity
              Class: rviz/PointCloud2
              Color: 52; 101; 164
              Color Transformer: AxisColor
              Decay Time: 0
              Enabled: true
              Invert Rainbow: false
              Max Color: 255; 255; 255
              Min Color: 0; 0; 0
              Name: local_inflate_map
              Position Transformer: XYZ
              Queue Size: 10
              Selectable: true
              Size (Pixels): 3
              Size (m): 0.20000000298023224
              Style: Flat Squares
              Topic: /drone0/mapping_vis/vs_gridmap_inflate
              Unreliable: false
              Use Fixed Frame: true
              Use rainbow: true
              Value: true
        - Class: rviz/Group
          Enabled: true
          Name: planning
          Displays:
            - Alpha: 1
              Buffer Length: 1
              Class: rviz/Path
              Color: 0; 0; 255
              Enabled: true
              Line Style: Billboards
              Line Width: 0.07000000029802322
              Name: traj
              Queue Size: 10
              Topic: /drone0/planning/traj
              Unreliable: false
              Value: true
            - Alpha: 1
              Buffer Length: 1
              Class: rviz/Path
              Color: 255; 100; 0
              Enabled: true
              Line Style: Billboards
              Line Width: 0.05
              Name: car_predict
              Queue Size: 10
              Topic: /drone0/planning/car_predict
              Unreliable: false
              Value: true
            - Alpha: 1
              Buffer Length: 1
              Class: rviz/Path
              Color: 255; 0; 255
              Enabled: true
              Line Style: Billboards
              Line Width: 0.10000000149011612
              Name: observable_margin
              Queue Size: 10
              Topic: /drone0/planning/observable_margin
              Unreliable: false
              Value: true
            - Alpha: 0.20000000298023224
              BoundColor: 255; 0; 0
              Class: decomp_rviz_plugins/PolyhedronArray
              Enabled: false
              MeshColor: 0; 170; 255
              Name: corridor
              Queue Size: 10
              Scale: 0.0010000000474974513
              State: Both
              Topic: /drone0/planning/polyhedra
              Unreliable: false
              Value: false
              VsColor: 0; 255; 0
              VsScale: 1
            - Alpha: 1
              Autocompute Intensity Bounds: true
              Autocompute Value Bounds:
                Max Value: 10
                Min Value: -10
                Value: true
              Axis: Z
              Channel Name: intensity
              Class: rviz/PointCloud2
              Color: 255; 0; 0
              Color Transformer: FlatColor
              Decay Time: 0
              Enabled: false
              Invert Rainbow: false
              Max Color: 255; 255; 255
              Min Color: 0; 0; 0
              Name: way_pts
              Position Transformer: XYZ
              Queue Size: 10
              Selectable: true
              Size (Pixels): 3
              Size (m): 0.20000000298023224
              Style: Spheres
              Topic: /drone0/planning/way_pts
              Unreliable: false
              Use Fixed Frame: true
              Use rainbow: true
              Value: false
            - Alpha: 1
              Buffer Length: 1
              Class: rviz/Path
              Color: 255; 0; 255
              Enabled: false
              Line Style: Billboards
              Line Width: 0.029999999329447746
              Name: astar
              Queue Size: 10
              Topic: /drone0/planning/astar
              Unreliable: false
              Value: false
            - Class: rviz/Marker
              Enabled: true
              Marker Topic: /drone0/planning/visible_region
              Name: visible_region
              Namespaces:
                "": true
              Queue Size: 100
              Value: true
            - Class: rviz/Marker
              Enabled: false
              Marker Topic: /drone0/planning/ray
              Name: ray
              Namespaces:
                {}
              Queue Size: 100
              Value: false
            - Alpha: 1
              Autocompute Intensity Bounds: true
              Autocompute Value Bounds:
                Max Value: 10
                Min Value: -10
                Value: true
              Axis: Z
              Channel Name: intensity
              Class: rviz/PointCloud2
              Color: 255; 0; 0
              Color Transformer: FlatColor
              Decay Time: 0
              Enabled: false
              Invert Rainbow: false
              Max Color: 255; 255; 255
              Min Color: 0; 0; 0
              Name: visible_ps
              Position Transformer: XYZ
              Queue Size: 10
              Selectable: true
              Size (Pixels): 3
              Size (m): 0.10000000149011612
              Style: Spheres
              Topic: /drone0/planning/visible_ps
              Unreliable: false
              Use Fixed Frame: true
              Use rainbow: true
              Value: false
            - Alpha: 1
              Buffer Length: 1
              Class: rviz/Path
              Color: 255; 255; 0
              Enabled: false
              Line Style: Billboards
              Line Width: 0.029999999329447746
              Name: check_pts
              Queue Size: 10
              Topic: /drone0/planning/check_pts
              Unreliable: false
              Value: false
            - Alpha: 1
              Buffer Length: 1
              Class: rviz/Path
              Color: 255; 0; 0
              Enabled: false
              Line Style: Billboards
              Line Width: 0.05
              Name: invalid_pts
              Queue Size: 10
              Topic: /drone0/planning/invalid_pts
              Unreliable: false
              Value: false

