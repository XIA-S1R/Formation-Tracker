<launch>

  <arg name="rhosVisibility_"/>
  <arg name="rhoTracking_" default="100000.0"/>
  <arg name="target_name_"/>
  <!-- Formation args: drone_id (int), formation_type_ ("none"|"hexagon"|"triangle"|"square"|"pentagon") -->
  <arg name="drone_id"        default="0"/>
  <arg name="formation_type_" default="none"/>
  <arg name="num_drones"      default="3"/>
  <arg name="weight_formation_" default="10000.0"/><!-- 100000.0-->
  <arg name="formation_grad_clip_" default="15.0"/><!-- 编队梯度限幅阈值，<=0 表示关闭 -->

  <node pkg="nodelet" type="nodelet" name="planning" args="load planning/Nodelet manager" output="screen">
    <remap from="~odom" to="odom"/>
    <remap from="~gridmap_inflate" to="gridmap_inflate"/>
    <remap from="~heartbeat" to="heartbeat"/>
    <remap from="~trajectory" to="trajectory"/>
    <remap from="~replanState" to="replanState"/>
    <remap from="~target" to="$(arg target_name_)"/>
    <remap from="~triger" to="/triger"/> <!-- 在追踪者的规划上，triger只作为启动开关，不决定目标位置 -->
    <remap from="~land_triger" to="/land_triger"/>

    <param name="plan_hz"        value="40"/>
    <param name="hard_replan_hz" value="10"/>
    <param name="K"              value="8"/>
    <param name="vmax"           value="3.0"/>
    <param name="amax"           value="6.0"/>
    <param name="rhoT"           value="10.0"/>
    <param name="rhoP"           value="100000.0"/>
    <param name="rhoV"           value="1000.0"/>
    <param name="rhoA"           value="1000.0"/>
    <param name="rhoTracking"    value="$(arg rhoTracking_)"/><!-- 追踪成本的权重 -->
    <param name="rhosVisibility" value="$(arg rhosVisibility_)"/><!-- 可视性成本的权重 -->
    <param name="theta_clearance" value="0.8"/><!-- 距离可视区域边界的安全间隙 -->
    <param name="clearance_d"    value="0.5"/><!-- 距离障碍物的安全间隙 -->
    <param name="use_soft_constraint" value="true"/><!-- true: ESDF软约束, false: 走廊硬约束 -->
    <param name="tolerance_d"    value="0.5"/>
    <param name="tracking_dist"  value="3.0"/><!-- 希望维持的跟踪距离 -->
    <param name="tracking_dur"   value="3.0"/><!-- 跟踪规划规划未来3s的轨迹 -->
    <param name="tracking_dt"    value="0.2"/><!-- 采样间隔，用于计算代价 -->
    <param name="obs_clip_enable" value="true"/><!-- 前端路径截断到观测半径内 -->
    <param name="obs_clip_range"  value="7.0"/><!-- 观测半径（建议比 mapping/sensor_range 小） -->
    <param name="obs_clip_margin" value="0.5"/><!-- 裁剪边界留白 -->
    <param name="post_reacquire_boost_sec" value="3.0"/><!-- 退出搜索后暂时关闭编队代价 -->
    <param name="formation_heading_speed_thresh" value="0.2"/><!-- 目标低速时保持上次编队朝向 -->
    <param name="debug"          value="false"/>

    <param name="prediction/rho_a" value="1.0"/><!-- A*搜索中对加速度的惩罚 -->
    <param name="prediction/vmax"  value="4.0"/>
    <param name="num_drones"       value="$(arg num_drones)" type="int"/>

    <!-- Swarm / formation parameters -->
    <param name="rhoSwarm"                       value="0.0"/><!-- 集群避撞权重 10000-->
    <param name="optimization/drone_id"          value="$(arg drone_id)" type="int"/>
    <!-- formation_type: 0 = none, 1 = regular hexagon ring (6 drones), 2 = equilateral triangle (3 drones), 3 = square (4 drones), 4 = regular pentagon (5 drones) -->
    <param name="optimization/formation_type"
           value="$(eval 1 if arg('formation_type_') == 'hexagon' else (2 if arg('formation_type_') == 'triangle' else (3 if arg('formation_type_') == 'square' else (4 if arg('formation_type_') == 'pentagon' else 0))))" type="int"/>
    <param name="optimization/use_formation"
           value="$(eval arg('formation_type_') != 'none')" type="bool"/>
    <param name="optimization/use_tracking_cost" value="true" type="bool"/>
    <param name="optimization/weight_formation"  value="$(arg weight_formation_)"/><!-- 编队保持权重 -->
    <param name="optimization/formation_grad_clip" value="$(arg formation_grad_clip_)"/><!-- 编队梯度clip阈值 -->
    <param name="optimization/formation_size"
           value="$(eval 6 if arg('formation_type_') == 'hexagon' else (3 if arg('formation_type_') == 'triangle' else (4 if arg('formation_type_') == 'square' else (5 if arg('formation_type_') == 'pentagon' else 0))))" type="int"/>

  </node>

  <node pkg="planning" name="traj_server" type="traj_server" output="screen"><!-- 轨迹发布节点，将规划的轨迹转化为位置控制指令发送给target/position_cmd话题 -->
    <remap from="~position_cmd" to="position_cmd"/>
    <remap from="~trajectory"   to="trajectory"/>
    <remap from="~heartbeat"    to="heartbeat"/>
    <param name="time_forward"  value="1.0" type="double"/>
  </node>
</launch>
