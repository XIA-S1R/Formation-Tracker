<launch>
  <arg name="num_worker_threads_" default="4"/>
  <arg name="sensor_range_" default="10.0"/>
  <arg name="sensor_rate_" default="20.0"/>
  <arg name="resolution_" default="0.15"/>
  <arg name="local_x_" default="20"/>
  <arg name="local_y_" default="20"/>
  <arg name="local_z_" default="5"/>
  <arg name="inflate_size_" default="1"/>
  <arg name="use_mask_" default="false"/>
  <arg name="start_manager_" default="true"/>
  <arg name="manager_name_" default="manager"/>

  <node if="$(arg start_manager_)"
        pkg="nodelet" type="nodelet" name="$(arg manager_name_)"
        args="manager" output="screen">
    <param name="num_worker_threads" value="$(arg num_worker_threads_)"/>
  </node>

  <node pkg="nodelet" type="nodelet" name="mapping"
        args="load mapping/Nodelet $(arg manager_name_)" output="screen">
    <remap from="~global_map"      to="/global_map"/>
    <remap from="~odom"            to="odom"/>
    <remap from="~gridmap_inflate" to="gridmap_inflate"/>
    <param name="sensor_range"     value="$(arg sensor_range_)"/>
    <param name="sensor_rate"      value="$(arg sensor_rate_)"/>
    <param name="p_min"            value="-199"/>
    <param name="p_max"            value="220"/>
    <param name="p_hit"            value="400"/>
    <param name="p_mis"            value="30"/>
    <param name="p_occ"            value="100"/>
    <param name="p_def"            value="-199"/>
    <param name="resolution"       value="$(arg resolution_)"/>
    <param name="local_x"          value="$(arg local_x_)"/>
    <param name="local_y"          value="$(arg local_y_)"/>
    <param name="local_z"          value="$(arg local_z_)"/>
    <param name="inflate_size"     value="$(arg inflate_size_)"/>
    <param name="use_mask"         value="$(arg use_mask_)"/>
  </node>
</launch>
